# Public browser configuration. These values are intentionally exposed to the browser.
# NEXT_PUBLIC_APP_URL must be an HTTPS origin in production; local development may use
# http://localhost or http://127.0.0.1. A trailing slash is normalized away.
NEXT_PUBLIC_APP_URL=
# Hosted Supabase URLs must use HTTPS. Local Supabase may use http://127.0.0.1:54321.
NEXT_PUBLIC_SUPABASE_URL=
# Public Supabase anon key only. Never place a service-role key here.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secrets. Never import these values into client components or expose them
# through NEXT_PUBLIC_* variables or logs. Production rejects placeholder/test values.
# Generate AUTH_FLOW_SIGNING_SECRET from at least 32 cryptographically random bytes.
# Keep it separate from every Supabase key and rotate it as an application secret.
AUTH_FLOW_SIGNING_SECRET=
# SUPABASE_SERVICE_ROLE_KEY is limited to trusted server provisioning, activation,
# report, parent, and audit paths. It is not required by the browser client.
SUPABASE_SERVICE_ROLE_KEY=
# PARENT_ACCESS_RATE_LIMIT_SECRET is server-only; generate at least 32 random bytes.
PARENT_ACCESS_RATE_LIMIT_SECRET=

# Operations/migration-only database URLs. The current web runtime does not require
# these values, so keep them out of the Vercel runtime unless a future feature needs them.
DATABASE_URL=
DIRECT_URL=
