# Safe for browser exposure. Values must still be non-secret public identifiers or URLs.
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never import these variables into client components or expose them in logs.
# Generate AUTH_FLOW_SIGNING_SECRET from at least 32 cryptographically random bytes.
# Keep it separate from every Supabase key and rotate it as an application secret.
AUTH_FLOW_SIGNING_SECRET=
# SUPABASE_SERVICE_ROLE_KEY is limited to trusted provisioning, activation, and audit paths.
SUPABASE_SERVICE_ROLE_KEY=
# PARENT_ACCESS_RATE_LIMIT_SECRET is server-only; generate at least 32 random bytes.
PARENT_ACCESS_RATE_LIMIT_SECRET=
DATABASE_URL=
DIRECT_URL=
